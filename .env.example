# Copy this file to .env and fill in real values.
# docker-compose reads these too.

# --- Database (async driver) ---
# When running the app on your host against the docker Postgres, use localhost.
# Inside docker-compose the app service overrides host to "db".
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# --- Redis (used ONLY for rate-limit counters) ---
REDIS_URL=redis://localhost:6379/0

# --- Provider credentials ---
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me

# --- App secrets ---
# Used for signing / general app secret. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Static key required to call the /v1/admin/* provisioning endpoints (sent as x-admin-key).
ADMIN_API_KEY=change-me-admin-key

# --- Optional tunables (defaults shown) ---
DEFAULT_RATE_LIMIT_PER_MIN=60
REQUEST_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
# Application log format: "text" (human, default) or "json" (structured).
LOG_FORMAT=text

# --- Resilience: retry (exponential backoff + full jitter) ---
# Total attempts per provider call (1 = no retry). Retries only transient
# failures (HTTP 408/429/5xx, timeouts) and honours upstream Retry-After.
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.25
RETRY_MAX_DELAY_SECONDS=8.0
RETRY_JITTER_SECONDS=0.25

# --- Resilience: circuit breaker (per provider:project) ---
CIRCUIT_BREAKER_ENABLED=true
# Consecutive transient failures that open the breaker.
CIRCUIT_BREAKER_FAIL_THRESHOLD=5
# Seconds the breaker stays open before allowing a half-open trial.
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# State backend: "memory" (single-process) or "redis" (multi-worker).
CIRCUIT_BREAKER_BACKEND=memory

# --- Response cache (opt-in; deterministic non-streaming requests only) ---
# Globally enable the Redis response cache. Per-request "cache": true also opts in.
RESPONSE_CACHE_ENABLED=false
RESPONSE_CACHE_TTL_SECONDS=300
RESPONSE_CACHE_PREFIX=respcache:
