# Copy this file to .env and fill in real values.
# docker-compose reads these too.

# --- Database (async driver) ---
# When running the app on your host against the docker Postgres, use localhost.
# Inside docker-compose the app service overrides host to "db".
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# --- Redis (used ONLY for rate-limit counters) ---
REDIS_URL=redis://localhost:6379/0

# --- Provider credentials ---
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me

# --- App secrets ---
# Used for signing / general app secret. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Static key required to call the /v1/admin/* provisioning endpoints (sent as x-admin-key).
ADMIN_API_KEY=change-me-admin-key

# --- Optional tunables (defaults shown) ---
DEFAULT_RATE_LIMIT_PER_MIN=60
REQUEST_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
